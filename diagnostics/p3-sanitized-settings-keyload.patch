@@ -36,6 +36,21 @@
 
 static struct bt_keys key_pool[CONFIG_BT_MAX_PAIRED];
 
+static uint32_t p3set_load_seq;
+
+static size_t p3set_pool_entries(void)
+{
+	size_t count = 0;
+
+	for (size_t i = 0; i < ARRAY_SIZE(key_pool); i++) {
+		if (key_pool[i].keys != 0U) {
+			count++;
+		}
+	}
+
+	return count;
+}
+
 #define BT_KEYS_STORAGE_LEN_COMPAT (BT_KEYS_STORAGE_LEN - sizeof(uint32_t))
 
 #if defined(CONFIG_BT_KEYS_OVERWRITE_OLDEST)
@@ -82,6 +97,7 @@
 
 void bt_keys_reset(void)
 {
+	LOG_INF("P3SET reset pool_entries_before=%zu", p3set_pool_entries());
 	memset(key_pool, 0, sizeof(key_pool));
 }
 
