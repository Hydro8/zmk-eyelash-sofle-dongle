+static void find_first_conn(struct bt_conn *conn, void *data);
+
+static void recovery_work_cb(struct k_work *work) {
+    if (!enabled) {
+        recovery_in_progress = false;
+        return;
+    }
+
+    struct bt_conn *conn = NULL;
+    bt_conn_foreach(BT_CONN_TYPE_LE, find_first_conn, &conn);
+
+    if (conn) {
+        int err = bt_conn_disconnect(conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+        if (err == 0) {
+            LOG_WRN("P3 recovery: disconnecting stale split connection");
+            return;
+        }
+        if (err != -ENOTCONN) {
+            LOG_WRN("P3 recovery: stale disconnect failed (%d)", err);
+            recovery_in_progress = false;
+            return;
+        }
+    }
+
+    low_duty_advertising = false;
+    int err = bt_le_adv_start(BT_LE_ADV_CONN_DIR_LOW_DUTY(BT_ADDR_LE_NONE), NULL, 0, NULL, 0);
+    if (err == 0) {
+        bt_le_adv_stop();
+    }
+
+    k_work_submit(&advertising_work);
+}
+
+K_WORK_DEFINE(recovery_work, recovery_work_cb);
+
 static void connected(struct bt_conn *conn, uint8_t err) {
     is_connected = (err == 0);
+    if (is_connected) {
+        recovery_in_progress = false;
+    }
 
     raise_zmk_split_peripheral_status_changed(
         (struct zmk_split_peripheral_status_changed){.connected = is_connected});
@@ -96,6 +131,7 @@ static void disconnected(struct bt_conn *conn, uint8_t reason) {
     LOG_DBG("Disconnected from %s (reason 0x%02x)", addr, reason);
 
     is_connected = false;
+    recovery_in_progress = false;
 
     raise_zmk_split_peripheral_status_changed(
         (struct zmk_split_peripheral_status_changed){.connected = is_connected});
@@ -137,6 +173,15 @@ struct zmk_split_transport_peripheral *zmk_split_transport_peripheral_bt(void) {
     return &bt_peripheral;
 }
 
+void zmk_split_bt_peripheral_request_recovery(void) {
+    if (!enabled || recovery_in_progress) {
+        return;
+    }
+
+    recovery_in_progress = true;
+    k_work_submit(&recovery_work);
+}
+
